extends tracon2019_base.jade

block content
  include content_toolbar_admin_blog_post.pug
  article.clearfix
    header
      h1 {{ blog_post.title }}
      p.post-meta
        small
          include content_blog_post_meta.html
    {{ blog_post.body|safe }}
  if blog_comments or blog_post.is_commenting_enabled
    h2 Kommentit
    if blog_comments
      for comment in blog_comments
        .tracon-blog-comment
          a.tracon-blog-comment-anchor(id='comment-{{ comment.id }}')
          p.text-muted: small {{ comment.author_name }} {{ comment.created_at|date:"j.n.Y G:i:s"}}
          {{ comment.comment|linebreaks }}
    else
      p.text-muted Ei kommentteja.
    if blog_post.is_commenting_enabled
      h3 Lähetä kommentti
      .row
        .tracon-blog-comment.col-md-8

    else
      p.text-muted Kommentointi on suljettu.
