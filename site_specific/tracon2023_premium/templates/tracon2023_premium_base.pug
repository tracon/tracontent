doctype html
- load static from static
html
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    meta(name='description', content='{{ site_settings.description }}')
    meta(name='keywords', content='{{ site_settings.keywords }}')

    title
      block full_title
        {% if page.title %}{{ page.title }} – {{ site_settings.title }}{% else %}{{ site_settings.title }}{% endif %}

    //- Favicons
    link(rel="shortcut icon" href="tracon2023_premium/images/favicon.png")
    //- link(rel="apple-touch-icon" href="tracon2023_premium/images/apple-touch-icon.png")
    //- link(rel="apple-touch-icon" sizes="72x72" href="tracon2023_premium/images/apple-touch-icon-72x72.png")
    //- link(rel="apple-touch-icon" sizes="114x114" href="tracon2023_premium/images/apple-touch-icon-114x114.png")

    //- Web Fonts
    link(href="https://fonts.googleapis.com/css?family=Poppins:400,500,600%7cPlayfair+Display:400i" rel="stylesheet")
    link(href="https://use.fontawesome.com/releases/v5.0.6/css/all.css" rel="stylesheet")

    //- Plugins
    link(href="{% static 'tracon2023_premium/css/plugins.min.css' %}" rel="stylesheet")

    //- Template core CSS
    link(href="{% static 'tracon2023_premium/css/template.css' %}" rel="stylesheet")

    //- I'm too lazy to compile SCSS
    link(href="{% static 'tracon2023_premium/css/tracon2023_fixes.css' %}" rel="stylesheet")

  body

    //- Preloader
    .page-loader
      .page-loader-inner
        .spinner
          .double-bounce1
          .double-bounce2
    //- Preloader end

    //- Header
    header.header(class="header-transparent")
      .container-fluid

        //- Brand
        .inner-header
          a.inner-brand(href="/", style="display: inline")
            //- TODO Logo
            |{{ site_settings.title }}

        //- Navigation
        .inner-navigation.collapse
          include tracon2023_premium_navigation

        .extra-nav
            //- Do not remove this item (mobile menu toggle)
            li.nav-toggle
              a(href="#" data-toggle="collapse" data-target=".inner-navigation")
                span.menu-item-span: i.ti-menu
    //- Header end

    //- Wrapper
    .wrapper

      block content

      include tracon2023_premium_footer

    //- Wrapper end

    //- To top button
    a(href="#top" class="scroll-top"): i.fas.fa-angle-up

    //- Scripts
    script(src="{% static 'tracon2023_premium/js/custom/jquery.min.js' %}")
    script(src="{% static 'tracon2023_premium/js/custom/popper.min.js' %}")
    script(src="{% static 'tracon2023_premium/js/bootstrap/bootstrap.min.js' %}")
    script(src="{% static 'tracon2023_premium/js/custom/plugins.min.js' %}")
    script(src="{% static 'tracon2023_premium/js/custom/custom.min.js' %}")
    if site_settings.google_analytics_token
      if not request.user.is_staff
        script.
          (function(i,s,o,g,r,a,m){i['GoogleAnalyticsObject']=r;i[r]=i[r]||function(){
          (i[r].q=i[r].q||[]).push(arguments)},i[r].l=1*new Date();a=s.createElement(o),
          m=s.getElementsByTagName(o)[0];a.async=1;a.src=g;m.parentNode.insertBefore(a,m)
          })(window,document,'script','//www.google-analytics.com/analytics.js','ga');

          ga('create', '{{ site_settings.google_analytics_token }}', 'auto');
          ga('send', 'pageview');
