extends tracon2023_premium_base

block content

  // Hero
  section.module-cover.parallax.text-center(data-background="{{ page.some_header_image.url }}" data-overlay="0.3")
    .container

      .row
        .col-md-12
          h2= page.title
          //- ol.breadcrumb.justify-content-center
          //-    li.breadcrumb-item: a(href="#") Home
          //-    li.breadcrumb-item: a(href="#") Blog
          //-    li.breadcrumb-item.active Single Post
  // Hero end


  // Blog
  section
    .container
      .row
        .col-lg-8.m-auto
          // Post
          article.post
            .post-preview
            //-   img(src="assets/images/blog/1.jpg" alt="")
            .post-wrapper
              include tracon2023_premium_toolbar_admin_page
              {{ page.body|safe }}
              p &nbsp;

              for blog_post in blog_posts
                article(class='#{blog_post.featured_css}')
                  //- TODO ugly, do with css instead
                  if blog_post.is_featured
                    h2: a(href='#{blog_post.get_absolute_url()}')= blog_post.title
                    p.post-meta
                      include content_blog_post_meta.html
                    p.lead= blog_post.excerpt
                  else
                    h4: a(href='#{blog_post.get_absolute_url()}')= blog_post.title
                    p.post-meta
                      include content_blog_post_meta.html
